        },
        {
          "name": "Re-subscribe to Report",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Re-subscribed successfully', () => {",
                  "  pm.expect(pm.response.json().subscribed).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/reports/{{reportId}}/subscribe", "host": ["{{baseUrl}}"], "path": ["api", "reports", "{{reportId}}", "subscribe"] },
            "body": { "mode": "raw", "raw": "" }
          }
        }
      ]
    },
    {
      "name": "Internal",
      "item": [
        {
          "name": "Trigger Report Generation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response has queued count', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('queued', 1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/internal/reports/trigger", "host": ["{{baseUrl}}"], "path": ["internal", "reports", "trigger"] },
            "body": { "mode": "raw", "raw": "" }
          }
        },
        {
          "name": "Trigger Report Generation — blocked from non-allowlisted IP (expects 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// When running locally the server always allows 127.0.0.1, so 200 is also acceptable.",
                  "pm.test('Status is 200 or 403', () => {",
                  "  pm.expect([200, 403]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Forwarded-For", "value": "1.2.3.4" }],
            "url": { "raw": "{{baseUrl}}/internal/reports/trigger", "host": ["{{baseUrl}}"], "path": ["internal", "reports", "trigger"] },
            "body": { "mode": "raw", "raw": "" }
          }
        },
        {
          "name": "Verify Report Instance Generated",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Allow 3 seconds for the Kafka consumer to process the generation message.",
                  "// This busy-wait blocks the JS event loop — acceptable for a local integration test.",
                  "const waitUntil = Date.now() + 3000;",
                  "while (Date.now() < waitUntil) { /* wait */ }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('At least one report instance was generated', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('data').that.is.an('array');",
                  "  pm.expect(body.data.length, 'Expected at least 1 generated instance').to.be.greaterThan(0);",
                  "});",
                  "pm.test('Generated instance has required fields', () => {",
                  "  const instance = pm.response.json().data[0];",
                  "  pm.expect(instance).to.have.property('reportId', pm.collectionVariables.get('reportId'));",
                  "  pm.expect(instance).to.have.property('s3Location').that.is.a('string').and.not.empty;",
                  "  pm.expect(instance).to.have.property('documentCount').that.is.a('number');",
                  "  pm.expect(instance).to.have.property('generatedAt').that.is.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/reports/{{reportId}}/instances", "host": ["{{baseUrl}}"], "path": ["api", "reports", "{{reportId}}", "instances"] }
          }
        }
      ]
    },
