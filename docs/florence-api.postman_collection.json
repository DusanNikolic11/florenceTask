        {
          "name": "Trigger Report Generation — blocked from non-allowlisted IP (expects 403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Forwarded-For", "value": "1.2.3.4" }],
            "url": { "raw": "{{baseUrl}}/internal/reports/trigger", "host": ["{{baseUrl}}"], "path": ["internal", "reports", "trigger"] },
            "body": { "mode": "raw", "raw": "" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// This test passes when called from a non-allowlisted IP.",
                  "// When running locally the server allows 127.0.0.1, so it may return 200.",
                  "pm.test('Status is 200 or 403', () => {",
                  "  pm.expect([200, 403]).to.include(pm.response.code);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
