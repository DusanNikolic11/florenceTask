              }
            }
          ]
        },
        {
          "name": "Get Report by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/reports/{{reportId}}", "host": ["{{baseUrl}}"], "path": ["api", "reports", "{{reportId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response matches saved report', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body._id).to.eql(pm.collectionVariables.get('reportId'));",
                  "  pm.expect(body.name).to.eql('Monthly 06 Report');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Report",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/reports/{{reportId}}", "host": ["{{baseUrl}}"], "path": ["api", "reports", "{{reportId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"frequencyDays\": 14,\n  \"enabled\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Report was updated', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.frequencyDays).to.eql(14);",
                  "  pm.expect(body.enabled).to.eql(false);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Report Instances",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/reports/{{reportId}}/instances", "host": ["{{baseUrl}}"], "path": ["api", "reports", "{{reportId}}", "instances"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response is an array', () => {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Subscribe to Report",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/reports/{{reportId}}/subscribe", "host": ["{{baseUrl}}"], "path": ["api", "reports", "{{reportId}}", "subscribe"] },
            "body": { "mode": "raw", "raw": "" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response shows subscribed: true', () => {",
                  "  pm.expect(pm.response.json().subscribed).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
