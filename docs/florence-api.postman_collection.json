{
  "info": {
    "name": "Florence Task API",
    "_postman_id": "f10rence-api-collection-v1",
    "description": "Integration tests for the Florence Task API.\n\nRun order: Authentication → Documents → Reports → Internal → Auth Guards.\n\n**Randomization:** The Register pre-request script mints a `runId` and derives all run-scoped variables from it (`userEmail`, `docFilename`, `docFilenameUpdated`, `reportPattern`). This lets the collection run repeatedly without conflicts.\n\n**File upload:** Set Postman's working directory (Settings → General → Working directory) to the repository root so that the relative path `docs/test-fixtures/sample-upload.txt` resolves correctly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",            "value": "http://localhost:3000", "type": "string" },
    { "key": "authToken",          "value": "",                      "type": "string" },
    { "key": "documentId",         "value": "",                      "type": "string" },
    { "key": "reportId",           "value": "",                      "type": "string" },
    { "key": "runId",              "value": "",                      "type": "string" },
    { "key": "userEmail",          "value": "",                      "type": "string" },
    { "key": "docFilename",        "value": "",                      "type": "string" },
    { "key": "docFilenameUpdated", "value": "",                      "type": "string" },
    { "key": "reportPattern",      "value": "",                      "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Math.random().toString(36).substring(2, 8).toUpperCase();",
                  "pm.collectionVariables.set('runId',              runId);",
                  "pm.collectionVariables.set('userEmail',          `dusannikolic11+${runId}@gmail.com`);",
                  "pm.collectionVariables.set('docFilename',        `2024_06_${runId}.pdf`);",
                  "pm.collectionVariables.set('docFilenameUpdated', `2024_06_${runId}_v2.pdf`);",
                  "pm.collectionVariables.set('reportPattern',      `*06_${runId}*`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Response contains accessToken', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('accessToken');",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Test1234!\"\n}" }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response contains accessToken', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('accessToken');",
                  "  pm.collectionVariables.set('authToken', body.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Test1234!\"\n}" }
          }
        },
        {
          "name": "Login — wrong password (expects 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 403 Forbidden', () => pm.response.to.have.status(403));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"wrongpassword\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Upload Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Response contains document fields and stores ID', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('_id');",
                  "  pm.expect(body).to.have.property('Filename', pm.collectionVariables.get('docFilename'));",
                  "  pm.expect(body).to.have.property('FileLocation');",
                  "  pm.expect(body).to.have.property('Size');",
                  "  pm.expect(body).to.have.property('MD5');",
                  "  pm.collectionVariables.set('documentId', body._id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/documents", "host": ["{{baseUrl}}"], "path": ["api", "documents"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "description": "Path is relative to Postman working directory — set it to the repo root.",
                  "type": "file",
                  "src": "docs/test-fixtures/sample-upload.txt"
                },
                { "key": "filename", "value": "{{docFilename}}", "type": "text" }
              ]
            }
          }
        },
        {
          "name": "List Documents (page 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response is paginated', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('data').that.is.an('array');",
                  "  pm.expect(body).to.have.property('total').that.is.a('number');",
                  "  pm.expect(body).to.have.property('page', 1);",
                  "  pm.expect(body).to.have.property('limit', 20);",
                  "  pm.expect(body).to.have.property('totalPages').that.is.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/documents?page=1&limit=20",
              "host": ["{{baseUrl}}"], "path": ["api", "documents"],
              "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "20" }]
            }
          }
        },
        {
          "name": "Get Document by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Response matches saved document', () => {",
                  "  pm.expect(pm.response.json()._id).to.eql(pm.collectionVariables.get('documentId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/documents/{{documentId}}", "host": ["{{baseUrl}}"], "path": ["api", "documents", "{{documentId}}"] }
          }
        },
        {
          "name": "Update Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Filename was updated', () => {",
                  "  pm.expect(pm.response.json().Filename).to.eql(pm.collectionVariables.get('docFilenameUpdated'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/documents/{{documentId}}", "host": ["{{baseUrl}}"], "path": ["api", "documents", "{{documentId}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"Filename\": \"{{docFilenameUpdated}}\"\n}" }
          }
        },
        {
          "name": "Download Document File",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Disposition header is present', () => {",
                  "  pm.expect(pm.response.headers.get('content-disposition')).to.include('attachment');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/documents/{{documentId}}/file", "host": ["{{baseUrl}}"], "path": ["api", "documents", "{{documentId}}", "file"] }
          }
        },
        {
          "name": "Get Non-existent Document (expects 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/documents/000000000000000000000000", "host": ["{{baseUrl}}"], "path": ["api", "documents", "000000000000000000000000"] }
          }
        },
        {
          "name": "Delete Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status is 204 No Content', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/documents/{{documentId}}", "host": ["{{baseUrl}}"], "path": ["api", "documents", "{{documentId}}"] }
          }
        },
        {
          "name": "Re-create Document (restores documentId for report generation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Document re-created and documentId updated', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('_id');",
                  "  pm.expect(body.Filename).to.eql(pm.collectionVariables.get('docFilename'));",
                  "  pm.collectionVariables.set('documentId', body._id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/documents", "host": ["{{baseUrl}}"], "path": ["api", "documents"] },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "description": "Same fixture file as Upload Document.",
                  "type": "file",
                  "src": "docs/test-fixtures/sample-upload.txt"
                },
                { "key": "filename", "value": "{{docFilename}}", "type": "text" }
              ]
            }
          }
        }
      ]
    },
